    "mdsvex": "^0.12.6",
    "svelte": "^5.41.0",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.0.5"
  }
}
